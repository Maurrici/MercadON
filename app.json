{
  "expo": {
    "name": "MercadON",
    "slug": "MercadON",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mercadon",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "icon": "./assets/branding/mercadon-app-icon.png",
    "ios": {},
    "android": {
      "package": "com.maurrici.mercadon",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/mercadon-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/mercadon-logo-compact.png",
          "imageWidth": 224,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b44dc29-1b32-4825-be9b-888fc9f176e4"
      }
    },
    "owner": "maurrici"
  }
}
